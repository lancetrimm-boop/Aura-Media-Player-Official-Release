<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Refined Geometric A Mark (Authoritative) -->
    <!-- Pillars are 8 units thick at top and bottom. Gap at top is 8 units. -->

    <!-- Left Pillar -->
    <path
        android:fillColor="@color/aura_logo_a"
        android:pathData="M42,35 L50,35 L25,85 L17,85 Z" />

    <!-- Right Pillar -->
    <path
        android:fillColor="@color/aura_logo_a"
        android:pathData="M58,35 L66,35 L91,85 L83,85 Z" />

    <!-- Centered Aura Core (Gradient Circle) -->
    <path
        android:pathData="M54,60 m-12,0 a12,12 0 1,1 24,0 a12,12 0 1,1 -24,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="42"
                android:startY="48"
                android:endX="66"
                android:endY="72">
                <item android:offset="0.0" android:color="#8B5CF6" />
                <item android:offset="0.5" android:color="#D946EF" />
                <item android:offset="1.0" android:color="#EC4899" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
